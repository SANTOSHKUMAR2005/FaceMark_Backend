DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/attendance_db
SECRET_KEY=change-this-to-a-long-random-string
TEACHER_SIGNUP_CODE=TEACHER123
ALLOWED_EMAIL_DOMAINS=gmail.com
FRONTEND_ORIGIN=http://localhost:5173

# Google Cloud Storage (leave GCS_BUCKET empty to store photos locally in backend/uploads for testing)
